{
  "compilerOptions": {
    // module must match moduleResolution: node16 (TS5110).
    "module": "node16",
    "moduleResolution": "node16",
    "target": "es6",
    "declaration": true,
    "declarationMap": true,
    "outDir": "./dist",
    // TypeScript 6 requires rootDir to be explicit when the common source
    // directory sits outside the project; src also pulls in ../shared/src, so
    // the common root is packages/. Pinning it keeps the existing
    // dist/<platform>/upscalerjs/src/... layout the package exports rely on.
    "rootDir": "..",
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "composite": false,
    "noUnusedLocals": true,
    "esModuleInterop": true,
    "strictNullChecks": true,
    "removeComments": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "rootDirs": ["./src", "../shared/src"],
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "**/*.test.ts"]
}
