{
  "name": "@internals/test-runner",
  "private": true,
  "type": "module",
  "exports": {
    "./clientside": "./dist/ClientsideTestRunner.js",
    "./serverside": "./dist/ServersideTestRunner.js"
  },
  "version": "0.1.0",
  "description": "Classes for managing the test runner process, including server boot up, puppeteer, and more",
  "author": "Kevin Scott",
  "license": "MIT",
  "dependencies": {
    "@internals/common": "workspace:*",
    "@internals/http-server": "workspace:*",
    "puppeteer": "^24.0.0",
    "fs-extra": "^11.4.0"
  },
  "wireit": {
    "copy-files": {
      "command": "rsync -avmq --include='*.ejs' -f 'hide,! */' ./src/ ./dist",
      "files": [
        "package.json",
        "./src/_templates/**/*.ejs"
      ],
      "output": [
        "dist/_templates/**"
      ]
    },
    "build": {
      "command": "pnpm copy-files && tsc -p ./tsconfig.json",
      "dependencies": [
        "../common:build",
        "../http-server:build"
      ],
      "files": [
        "src/**/*.ts",
        "!src/**/*.test.ts",
        "_templates/**/*.ejs",
        "package.json",
        "vitest.config.ts",
        "tsconfig.json"
      ],
      "output": [
        "dist/**"
      ]
    },
    "test:run": {
      "command": "vitest run --config ./vite.config.ts"
    },
    "test": {
      "command": "vitest --config ./vite.config.ts"
    }
  },
  "scripts": {
    "build": "wireit",
    "copy-files": "wireit",
    "test:run": "wireit",
    "test": "wireit"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "wireit": "^0.14.13",
    "vitest": "^4.1.10"
  }
}
